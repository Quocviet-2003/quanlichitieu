generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==============================
// NGƯỜI DÙNG
// ==============================
model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  password     String
  name         String?
  bio          String?
  avatar       String?
  role         String        @default("USER") // 'USER' | 'ADMIN'
  status       String        @default("ACTIVE") // 'ACTIVE' | 'BLOCKED'
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions Transaction[]
  budgets      Budget[]
  savingsGoals SavingsGoal[]
  aiLogs       AiLog[]
  fixedExpenses FixedExpense[]
  notifications Notification[]
}



// ==============================
// GIAO DỊCH THU / CHI
// ==============================
model Transaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  amount      Float
  type        String   // 'THU' hoặc 'CHI'; cron chi cố định sẽ tạo bản ghi 'CHI'
  category    String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  // Toạ độ nơi giao dịch diễn ra (ví dụ siêu thị, quán ăn), tuỳ chọn.
  // MongoDB không cần kiểu địa lý riêng (như PostGIS) - lưu thẳng 2 field số thực.
  latitude  Float?
  longitude Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
}

// ==============================
// NGÂN SÁCH THEO DANH MỤC / THÁNG
// ==============================
model Budget {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  category    String
  limitAmount Float // Hạn mức chi tiêu tối đa trong tháng
  month       String   // Định dạng 'YYYY-MM'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
  @@index([userId, month])
}

// ==============================
// MỤC TIÊU TIẾT KIỆM
// ==============================
model SavingsGoal {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String    @db.ObjectId
  name                String
  targetAmount        Float // Số tiền mục tiêu
  currentAmount       Float     @default(0) // Số tiền đã tích lũy
  monthlyContribution Float? // Kế hoạch đóng góp mỗi tháng
  deadline            DateTime?
  status              String    @default("IN_PROGRESS") // 'IN_PROGRESS' | 'COMPLETED'
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==============================
// DANH MỤC MẶC ĐỊNH TOÀN HỆ THỐNG (Admin quản lý)
// ==============================
model Category {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String @unique
  icon  String @default("more-horizontal")
  color String @default("#64748b")
  type  String @default("BOTH") // 'CHI' | 'THU' | 'BOTH'
}

// ==============================
// NHẬT KÝ SỬ DỤNG AI (phục vụ thống kê admin)
// ==============================
model AiLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String?  @db.ObjectId
  endpoint     String // 'ai-insights' | 'ai-chat'
  model        String
  tokens       Int      @default(0)
  costEstimate Float    @default(0) // Ước lượng chi phí (USD)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ==============================
// CẤU HÌNH HỆ THỐNG (key-value)
// ==============================
model AppSetting {
  key   String @id @map("_id")
  value String
}

// ==============================
// CHI TIÊU CỐ ĐỊNH HÀNG THÁNG
// ==============================
model FixedExpense {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId // Chủ sở hữu lịch; lấy từ token khi tạo
  amount       Float     // Số tiền cần tạo giao dịch CHI mỗi kỳ
  category     String    // Danh mục dùng cho giao dịch CHI và báo cáo
  description  String?   // Tên/ghi chú hiển thị, ví dụ "Tiền Internet"
  deductDay    Int       @default(1) // Ngày tự động trừ tiền trong tháng (1-31)
  lastDeducted DateTime? // Lần thành công gần nhất; dùng chống thanh toán lặp trong tháng
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==============================
// THÔNG BÁO CHO NGƯỜI DÙNG
// ==============================
model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  title     String
  message   String
  isRead    Boolean  @default(false) // Mở chuông chỉ đánh dấu đã đọc, không xóa bản ghi
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}
