ười dùng" style="html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.4;edgeStyle=none;fontSize=14;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="790" as="sourcePoint"/><mxPoint x="1500" y="790" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e16" value="Cập nhật thành công" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=1.4;edgeStyle=none;fontSize=14;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="870" as="sourcePoint"/><mxPoint x="1060" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="Thông báo “Đổi mật khẩu thành công”" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=1.4;edgeStyle=none;fontSize=14;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="950" as="sourcePoint"/><mxPoint x="620" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="Xoá trống biểu mẫu và hiển thị thông báo" style="html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;strokeWidth=1.4;edgeStyle=none;fontSize=14;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1030" as="sourcePoint"/><mxPoint x="180" y="1030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="Luồng rẽ nhánh: nếu thiếu trường, mật khẩu mới dưới 6 ký tự hoặc nhập lại không khớp thì giao diện báo lỗi ngay; nếu mật khẩu hiện tại sai, máy chủ trả lỗi “Mật khẩu cũ không đúng.”" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="700" height="130" as="geometry"/></mxCell><mxCell id="e20" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#808