<mxfile host="app.diagrams.net"><diagram name="So do quan he CSDL" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Người dùng&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;thư điện tử: Chuỗi — duy nhất&lt;br&gt;mật khẩu: Chuỗi (đã mã hoá)&lt;br&gt;tên / tiểu sử / ảnh đại diện: Chuỗi, có thể trống&lt;br&gt;vai trò: Người dùng | Quản trị viên&lt;br&gt;trạng thái: Hoạt động | Bị khoá&lt;br&gt;ngày tạo: Ngày giờ&lt;br&gt;ngày cập nhật: Ngày giờ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="520" width="420" height="250" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Giao dịch&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;mã người dùng: Chuỗi — khoá ngoại&lt;br&gt;số tiền: Số thực &amp;gt; 0&lt;br&gt;loại: THU | CHI&lt;br&gt;danh mục: Chuỗi&lt;br&gt;ghi chú: Chuỗi, có thể trống&lt;br&gt;ngày: Ngày giờ&lt;br&gt;vĩ độ / kinh độ: Số thực, tuỳ chọn&lt;br&gt;ngày tạo: Ngày giờ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="40" width="420" height="270" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Ngân sách&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;mã người dùng: Chuỗi — khoá ngoại&lt;br&gt;danh mục: Chuỗi&lt;br&gt;hạn mức: Số thực&lt;br&gt;tháng: Chuỗi dạng năm-tháng&lt;br&gt;ngày tạo / ngày cập nhật: Ngày giờ&lt;br&gt;duy nhất (mã người dùng, danh mục, tháng)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="440" width="420" height="215" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Mục tiêu tiết kiệm&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;mã người dùng: Chuỗi — khoá ngoại&lt;br&gt;tên: Chuỗi&lt;br&gt;số tiền mục tiêu: Số thực&lt;br&gt;số tiền đã tích luỹ: Số thực (mặc định 0)&lt;br&gt;đóng góp hằng tháng: Số thực, tuỳ chọn&lt;br&gt;hạn chót: Ngày giờ, tuỳ chọn&lt;br&gt;trạng thái: Đang thực hiện | Đã hoàn thành&lt;br&gt;kỳ hạn: Ngắn hạn | Dài hạn&lt;br&gt;ngày tạo / ngày cập nhật: Ngày giờ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="790" width="420" height="270" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Chi tiêu cố định&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;mã người dùng: Chuỗi — khoá ngoại&lt;br&gt;số tiền: Số thực&lt;br&gt;danh mục: Chuỗi&lt;br&gt;ghi chú: Chuỗi, có thể trống&lt;br&gt;ngày trừ tiền: Số nguyên 1–31&lt;br&gt;lần trừ gần nhất: Ngày giờ, tuỳ chọn&lt;br&gt;ngày tạo / ngày cập nhật: Ngày giờ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1520" y="40" width="420" height="250" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Thông báo&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;mã người dùng: Chuỗi — khoá ngoại&lt;br&gt;tiêu đề: Chuỗi&lt;br&gt;nội dung: Chuỗi&lt;br&gt;đã đọc: Đúng / Sai (mặc định Sai)&lt;br&gt;ngày tạo: Ngày giờ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1520" y="440" width="420" height="195" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Nhật ký sử dụng AI&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;mã người dùng: Chuỗi — khoá ngoại, có thể trống&lt;br&gt;loại yêu cầu: ai-insights | ai-chat&lt;br&gt;mô hình: Chuỗi&lt;br&gt;số đơn vị xử lý: Số nguyên&lt;br&gt;chi phí ước tính: Số thực&lt;br&gt;ngày tạo: Ngày giờ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1520" y="720" width="420" height="220" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Danh mục&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;tên: Chuỗi — duy nhất&lt;br&gt;biểu tượng: Chuỗi&lt;br&gt;màu: Chuỗi&lt;br&gt;loại: CHI | THU | Cả hai" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="1180" width="420" height="170" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Cấu hình hệ thống&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;khoá: Chuỗi — khoá chính&lt;br&gt;giá trị: Chuỗi" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1520" y="1400" width="420" height="110" as="geometry"/></mxCell><mxCell id="e10" value="1 - nhiều" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.3;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.32;exitDx=0;exitDy=0;entryX=1;entryY=0.46;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="1 - nhiều" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.3;fontSize=14;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;ex