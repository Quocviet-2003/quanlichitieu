<mxfile host="app.diagrams.net"><diagram name="Quy trinh bam mat khau bcrypt" id="d1"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Cách bcrypt bảo vệ mật khẩu người dùng" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="40" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Khi đăng ký / đổi mật khẩu&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="320" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Mật khẩu người dùng nhập" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="280" height="80" as="geometry"/></mxCell><mxCell id="n4" value="Sinh chuỗi ngẫu nhiên (salt)&lt;br&gt;và băm với chi phí 10 vòng" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="300" height="80" as="geometry"/></mxCell><mxCell id="n5" value="Lưu chuỗi băm vào cơ sở dữ liệu&lt;br&gt;(không lưu mật khẩu gốc)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="150" width="380" height="80" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.4;fontSize=14;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" t