        <mxCell id="n6" value="&lt;b&gt;Thông báo&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;mã: Chuỗi — khoá chính&lt;br&gt;mã người dùng: Chuỗi — khoá ngoại&lt;br&gt;tiêu đề: Chuỗi&lt;br&gt;nội dung: Chuỗi&lt;br&gt;đã đọc: Đúng / Sai (mặc định Sai)&lt;br&gt;ngày tạo: Ngày giờ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
